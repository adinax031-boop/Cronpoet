    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adinax031-boop/Cronpoet.git"
  },
  "bugs": {
    "url": "https://github.com/adinax031-boop/Cronpoet/issues"
  },
  "homepage": "https://github.com/adinax031-boop/Cronpoet#readme",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
