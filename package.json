{
  "name": "@adinax031-boop/cronpoet",
  "version": "1.0.0",
  "description": "Cron expressions, in plain English â parse, validate, describe and schedule 5-field cron expressions. Zero-dependency TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
